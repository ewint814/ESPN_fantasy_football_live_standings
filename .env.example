# ESPN Fantasy Football Credentials
# Get these from your ESPN account:
# 1. Log into ESPN Fantasy Football in your browser
# 2. Open Developer Tools (F12)
# 3. Go to Application/Storage → Cookies → espn.com
# 4. Copy the values below

# Your ESPN Fantasy League ID (from the URL)
ESPN_LEAGUE_ID=your_league_id_here

# ESPN S2 Cookie (long string starting with AE...)
ESPN_S2=your_espn_s2_cookie_here

# ESPN SWID Cookie (format: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX})
ESPN_SWID=your_espn_swid_cookie_here

# Server Configuration
PORT=5000
